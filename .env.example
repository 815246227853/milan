# Bolna: places the vendor calls. Leave BOLNA_API_KEY empty to run with simulated calls.
BOLNA_API_KEY=
BOLNA_AGENT_VENDOR=          # filled in by `npm run sync-agent`
BOLNA_FROM_NUMBER=           # optional, your Bolna number in +91 format

# Demo mode: every vendor call is routed to these numbers (teammates playing vendors), round-robin.
# Leave empty to call the vendor's real number.
DEMO_PHONE_NUMBERS=+919800000001,+919800000002,+919800000003

# Google Places (vendor search). Leave empty to use the sample vendors in src/lib/agent/sampleVendors.ts.
GOOGLE_PLACES_API_KEY=

# OpenAI: reads the request and the call transcripts. Leave empty for the built-in rule-based parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Flagsmith (optional): calls_enabled, approval_over_budget, max_parallel_calls. Defaults apply when empty.
FLAGSMITH_ENVIRONMENT_KEY=

# Where the SQLite file lives
DATABASE_PATH=data/milan.db
