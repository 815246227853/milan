# Database and queue (docker compose defaults)
DATABASE_URL=postgres://milan:milan@localhost:5432/milan
REDIS_URL=redis://localhost:6379

# Sarvam: speech-to-text, text-to-speech, translation
SARVAM_API_KEY=

# Flagsmith: agent rules (server-side environment key)
FLAGSMITH_ENVIRONMENT_KEY=

# LLM for the agent (planner, tool calls, quote extraction)
LLM_API_KEY=
LLM_MODEL=

# Phone line: Twilio or Exotel
PHONE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL the phone line calls back to (e.g. an ngrok URL for port 4100)
PUBLIC_CALL_URL=

# Ports
WEB_PORT=3000
API_PORT=4000
CALL_WORKER_PORT=4100
